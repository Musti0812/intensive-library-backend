// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model LibraryItemType {
  id    String        @id @default(cuid())
  name  String        @unique
  items LibraryItem[]
}

model Category {
  id    String        @id @default(cuid())
  name  String        @unique
  items LibraryItem[]

}

model LibraryItem {
  id             String          @id @default(cuid())
  title          String
  acronym        String?
  libraryItemTypeId String
  libraryItemType LibraryItemType  @relation(fields: [libraryItemTypeId], references: [id])
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  isBorrowable   Boolean         @default(true)
  borrower       String?
  borrowDate     DateTime?
  author         String?
  nbrPages       Int?
  runTimeMinutes Int?

}
